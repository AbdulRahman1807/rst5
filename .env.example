# Copy this file to .env (gitignored) and fill in your own GROQ_API_KEY.
# Neo4j creds below are the fixed event credentials from the handout — not secret, but kept
# as env vars per the "never hard-code credentials" requirement.

# Event's fixed name is "CSV_Graph_DB", but Neo4j 5.x rejects underscores in database names
# ("contains illegal characters") — substituting dashes: csv-graph-db.
NEO4J_DATABASE=csv-graph-db
NEO4J_PASSWORD=csvgraphdb
NEO4J_URI=bolt://neo4j:7687

# Kafka Configuration
KAFKA_BROKERS=kafka:9092

# GroqCloud API Key (placeholder for Phase 2+)
GROQ_API_KEY=your_groq_api_key_here

# Optional override — api/chatbot.py already defaults to openai/gpt-oss-120b (confirmed
# working). llama-3.3-70b-versatile is gone from Groq's catalog as of this event — don't
# switch back to it. If you do change this, check reasoning_effort in chatbot.py still
# applies (gpt-oss models burn tokens on hidden reasoning and can return empty content
# without it).
# GROQ_MODEL=openai/gpt-oss-120b
