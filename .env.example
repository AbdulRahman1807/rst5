# Copy this file to .env (gitignored) and fill in your values.
# Neo4j creds below are the fixed event credentials from the handout.
# Event's fixed name is "CSV_Graph_DB", but Neo4j 5.x rejects underscores in database names
# ("contains illegal characters") — substituting dashes: csv-graph-db.

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=csvgraphdb
NEO4J_DATABASE=csv-graph-db

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=csv-rows
KAFKA_DLQ_TOPIC=csv-rows-dlq

# GroqCloud API Key (Required for LLM Text-to-Cypher; deterministic fallback works without it)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Query & Guardrail Limits
CYPHER_MAX_ROWS=200
CYPHER_TIMEOUT_SECONDS=5.0
MAX_UPLOAD_SIZE_MB=25

# Local / Hybrid Embeddings (Phase 3 local model)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

